{
  "id": "book-restaurant",
  "version": 1,
  "source": "handwritten",
  "description": "Reserve a table at a restaurant for a given party size, date, time, and optionally a cuisine",
  "utterance_examples": [
    "book me a table for two friday at seven",
    "get us a dinner reservation saturday night",
    "reserve somewhere italian for four people tomorrow at eight"
  ],
  "slots": [
    { "name": "party_size", "prompt": "How many people?", "example": "2" },
    { "name": "date", "prompt": "What day?", "example": "Friday" },
    { "name": "time", "prompt": "What time?", "example": "7:00 PM" },
    {
      "name": "cuisine",
      "prompt": "Any particular kind of food?",
      "example": "Italian",
      "required": false
    }
  ],
  "steps": [
    {
      "id": "open",
      "kind": "browser",
      "op": "goto",
      "url": "https://www.opentable.com",
      "description": "Open the reservations site using the logged-in profile",
      "expect": "[data-test='user-menu']"
    },
    {
      "id": "set-party",
      "kind": "browser",
      "op": "fill",
      "selector": "[data-test='party-size-picker']",
      "value": "{{party_size}}",
      "description": "Set the party size"
    },
    {
      "id": "set-datetime",
      "kind": "browser",
      "op": "fill",
      "selector": "[data-test='date-picker']",
      "value": "{{date}} {{time}}",
      "description": "Set the date and time"
    },
    {
      "id": "set-cuisine",
      "kind": "browser",
      "op": "fill",
      "selector": "[data-test='search-input']",
      "value": "{{cuisine}}",
      "description": "Filter by cuisine"
    },
    {
      "id": "search",
      "kind": "browser",
      "op": "submit",
      "selector": "[data-test='search-form']",
      "description": "Run the search",
      "expect": "[data-test='result-card']"
    },
    {
      "id": "read-top",
      "kind": "browser",
      "op": "read",
      "selector": "[data-test='result-card']:first-child [data-test='restaurant-name']",
      "capture": "restaurant_name",
      "description": "Read the top available restaurant"
    },
    {
      "id": "read-slot",
      "kind": "browser",
      "op": "read",
      "selector": "[data-test='result-card']:first-child [data-test='slot-time']",
      "capture": "slot_time",
      "description": "Read the exact time being offered"
    },
    {
      "id": "select-slot",
      "kind": "browser",
      "op": "click",
      "selector": "[data-test='result-card']:first-child [data-test='slot-time']",
      "description": "Open the reservation for that slot",
      "expect": "[data-test='complete-reservation']"
    },
    {
      "id": "confirm-booking",
      "kind": "browser",
      "op": "click",
      "selector": "[data-test='complete-reservation']",
      "description": "Complete the reservation",
      "irreversible": true,
      "confirm": "Booking {{restaurant_name}} for {{party_size}} at {{slot_time}} on {{date}}. Should I confirm?",
      "expect": "[data-test='confirmation-number']"
    },
    {
      "id": "read-confirmation",
      "kind": "browser",
      "op": "read",
      "selector": "[data-test='confirmation-number']",
      "capture": "confirmation_ref",
      "description": "Read back the confirmation number so it can be cancelled between rehearsals"
    }
  ]
}
