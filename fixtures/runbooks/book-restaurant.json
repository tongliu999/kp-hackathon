{
  "id": "book-restaurant",
  "name": "Book a restaurant table",
  "version": "1",
  "description": "Reserve a table at a restaurant for a given party size, date, time, city, and cuisine",
  "utterance_examples": [
    "book me a table for two friday at seven",
    "get us a dinner reservation saturday night",
    "reserve somewhere italian for four people tomorrow at eight"
  ],
  "slots": [
    {
      "name": "party_size",
      "type": "integer",
      "required": true,
      "description": "the party size",
      "prompt": "How many people?",
      "example": "2"
    },
    {
      "name": "cuisine",
      "type": "string",
      "required": false,
      "description": "the cuisine",
      "prompt": "Any particular kind of food?",
      "default": "any",
      "example": "Italian"
    },
    {
      "name": "city",
      "type": "string",
      "required": true,
      "description": "the city",
      "prompt": "Which city?",
      "example": "San Francisco"
    },
    {
      "name": "date",
      "type": "string",
      "required": true,
      "description": "the date",
      "prompt": "What day?",
      "example": "Friday"
    },
    {
      "name": "time",
      "type": "string",
      "required": true,
      "description": "the time",
      "prompt": "What time?",
      "example": "7:00 PM"
    }
  ],
  "steps": [
    {
      "id": "search",
      "action": "restaurant.search",
      "description": "Find available tables matching the request",
      "arguments": {
        "party_size": "{{party_size}}",
        "cuisine": "{{cuisine}}",
        "city": "{{city}}",
        "date": "{{date}}",
        "time": "{{time}}"
      },
      "irreversible": false
    },
    {
      "id": "book",
      "action": "restaurant.book",
      "description": "Place the reservation",
      "arguments": {
        "provider": "configured-provider",
        "party_size": "{{party_size}}",
        "cuisine": "{{cuisine}}",
        "city": "{{city}}",
        "date": "{{date}}",
        "time": "{{time}}"
      },
      "irreversible": true,
      "confirmation_prompt": "Table for {{party_size}}, {{cuisine}}, in {{city}} on {{date}} at {{time}}. Should I confirm?"
    },
    {
      "id": "read-confirmation",
      "action": "restaurant.read_confirmation",
      "description": "Read back the confirmation reference so it can be cancelled between rehearsals",
      "arguments": {},
      "irreversible": false
    }
  ]
}
